---
import '../styles/global.css';

const planUrl =
  'https://microsoft-my.sharepoint.com/:w:/p/aabdusalam/cQoJLXI_0_NIRb_JWfT16EoPEgUCPfjOiUModqkujnKd_ZMWmQ';
const canonicalUrl = new URL('/aabdusalam', Astro.site ?? 'https://aminuabdusalam.github.io');
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="robots" content="noindex, nofollow" />
    <meta name="description" content="The link you were probably looking for." />
    <link rel="canonical" href={canonicalUrl} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=IBM+Plex+Mono:wght@400;500&family=IBM+Plex+Sans:wght@400;500;600;700&family=IBM+Plex+Sans+Condensed:wght@600;700&display=swap"
      rel="stylesheet"
    />
    <title>Aminu's OOF buddy plan</title>
  </head>
  <body>
    <main class="landing">
      <div id="rickroll-prompt" class="plan-card">
        <p class="eyebrow">OOF buddy plan</p>
        <h1>Right this way.</h1>
        <p class="intro">Everything you need is one click away.</p>
        <a
          id="rickroll-link"
          class="plan-link"
          href="https://www.youtube.com/watch?v=dQw4w9WgXcQ&autoplay=1"
        >
          Open the plan
        </a>
      </div>

      <div id="oof-plan" class="plan-card" hidden>
        <p class="eyebrow">Okay, fine.</p>
        <h1>Just had to do that.</h1>
        <p class="intro">
          You're probably looking for my OOF buddy plan. Here you go.
        </p>
        <a class="plan-link" href={planUrl} target="_blank" rel="noreferrer">
          Open the OOF buddy plan
        </a>
        <p class="access-note">Microsoft sign-in required.</p>
      </div>
    </main>

    <script is:inline>
      const returnKey = 'aabdusalam-rickroll-returned';
      const prompt = document.querySelector('#rickroll-prompt');
      const plan = document.querySelector('#oof-plan');
      const rickrollLink = document.querySelector('#rickroll-link');

      const hasReturned = () => {
        try {
          return sessionStorage.getItem(returnKey) === 'true';
        } catch (error) {
          console.warn('Session storage is unavailable.', error);
          return false;
        }
      };
      const markReturned = () => {
        try {
          sessionStorage.setItem(returnKey, 'true');
        } catch (error) {
          console.warn('Session storage is unavailable.', error);
        }
      };
      const showCurrentState = () => {
        const params = new URLSearchParams(window.location.search);
        const returned =
          params.has('preview') || params.has('returned') || hasReturned();

        if (prompt) prompt.hidden = returned;
        if (plan) plan.hidden = !returned;
      };

      rickrollLink?.addEventListener('click', () => {
        markReturned();
        const returnUrl = new URL(window.location.href);
        returnUrl.search = '';
        returnUrl.searchParams.set('returned', '1');
        window.history.replaceState({ returned: true }, '', returnUrl);
      });

      showCurrentState();
      window.addEventListener('pageshow', showCurrentState);
    </script>
  </body>
</html>

<style>
  .landing {
    min-height: min(72vh, 48rem);
    padding: clamp(3rem, 10vw, 8rem) var(--space-5);
    place-items: center;
  }

  .plan-card {
    width: min(100%, 42rem);
    padding: clamp(2rem, 7vw, 4.5rem);
    border: 1px solid var(--color-border-strong);
    border-radius: var(--radius-lg);
    background: var(--color-bg-elevated);
    box-shadow: 10px 10px 0 var(--color-ink);
  }

  h1 {
    max-width: 10ch;
    margin-block: var(--space-4);
    font-size: clamp(3rem, 10vw, 6rem);
    line-height: 0.92;
  }

  .intro {
    max-width: 34ch;
    color: var(--color-text-muted);
    font-size: var(--fs-lg);
  }

  .plan-link {
    min-height: 48px;
    margin-top: var(--space-8);
    padding: var(--space-3) var(--space-5);
    display: inline-flex;
    align-items: center;
    justify-content: center;
    border: 1px solid var(--color-ink);
    border-radius: var(--radius-sm);
    background: var(--color-ink);
    color: white;
    font-family: var(--font-mono);
    font-weight: 500;
    text-decoration: none;
    box-shadow: 4px 4px 0 var(--color-accent);
    transition:
      transform var(--duration-fast) var(--ease-out),
      box-shadow var(--duration-fast) var(--ease-out);
  }

  .plan-link:hover {
    color: white;
    box-shadow: 2px 2px 0 var(--color-accent);
    transform: translate(2px, 2px);
  }

  .plan-link:focus-visible {
    outline: 3px solid var(--color-accent);
    outline-offset: 4px;
  }

  .access-note {
    margin-top: var(--space-4);
    color: var(--color-text-dim);
    font-family: var(--font-mono);
    font-size: var(--fs-xs);
  }

  @media (max-width: 640px) {
    .plan-card {
      box-shadow: 6px 6px 0 var(--color-ink);
    }
  }
</style>
