---
import BaseLayout from '../layouts/BaseLayout.astro';

const planUrl =
  'https://microsoft-my.sharepoint.com/:w:/p/aabdusalam/cQoJLXI_0_NIRb_JWfT16EoPEgUCPfjOiUModqkujnKd_ZMWmQ';
---

<BaseLayout
  title="Aminu's OOF buddy plan"
  description="The link you were probably looking for."
  noindex
>
  <section id="oof-plan" class="landing" hidden>
    <div class="plan-card">
      <p class="eyebrow">Okay, fine.</p>
      <h1>Just had to do that.</h1>
      <p class="intro">
        You're probably looking for my OOF buddy plan. Here you go.
      </p>
      <a class="plan-link" href={planUrl} target="_blank" rel="noreferrer">
        Open the OOF buddy plan
      </a>
      <p class="access-note">Microsoft sign-in required.</p>
    </div>
  </section>

  <noscript>
    <style>
      #oof-plan[hidden] {
        display: grid;
      }
    </style>
  </noscript>

  <script is:inline>
    const returnKey = 'aabdusalam-rickroll-returned';
    const landing = document.querySelector('#oof-plan');
    const preview = new URLSearchParams(window.location.search).has('preview');

    const revealPlan = () => landing?.removeAttribute('hidden');

    if (preview || sessionStorage.getItem(returnKey)) {
      revealPlan();
    } else {
      sessionStorage.setItem(returnKey, 'true');
      window.history.pushState({ returnToPlan: true }, '', window.location.href);
      window.location.assign('https://www.youtube.com/watch?v=dQw4w9WgXcQ&autoplay=1');
    }

    window.addEventListener('pageshow', () => {
      if (sessionStorage.getItem(returnKey)) {
        revealPlan();
      }
    });
  </script>
</BaseLayout>

<style>
  .landing {
    min-height: min(72vh, 48rem);
    padding: clamp(3rem, 10vw, 8rem) var(--space-5);
    place-items: center;
  }

  .plan-card {
    width: min(100%, 42rem);
    padding: clamp(2rem, 7vw, 4.5rem);
    border: 1px solid var(--color-border-strong);
    border-radius: var(--radius-lg);
    background: var(--color-bg-elevated);
    box-shadow: 10px 10px 0 var(--color-ink);
  }

  h1 {
    max-width: 10ch;
    margin-block: var(--space-4);
    font-size: clamp(3rem, 10vw, 6rem);
    line-height: 0.92;
  }

  .intro {
    max-width: 34ch;
    color: var(--color-text-muted);
    font-size: var(--fs-lg);
  }

  .plan-link {
    min-height: 48px;
    margin-top: var(--space-8);
    padding: var(--space-3) var(--space-5);
    display: inline-flex;
    align-items: center;
    justify-content: center;
    border: 1px solid var(--color-ink);
    border-radius: var(--radius-sm);
    background: var(--color-ink);
    color: white;
    font-family: var(--font-mono);
    font-weight: 500;
    text-decoration: none;
    box-shadow: 4px 4px 0 var(--color-accent);
    transition:
      transform var(--duration-fast) var(--ease-out),
      box-shadow var(--duration-fast) var(--ease-out);
  }

  .plan-link:hover {
    color: white;
    box-shadow: 2px 2px 0 var(--color-accent);
    transform: translate(2px, 2px);
  }

  .plan-link:focus-visible {
    outline: 3px solid var(--color-accent);
    outline-offset: 4px;
  }

  .access-note {
    margin-top: var(--space-4);
    color: var(--color-text-dim);
    font-family: var(--font-mono);
    font-size: var(--fs-xs);
  }

  @media (max-width: 640px) {
    .plan-card {
      box-shadow: 6px 6px 0 var(--color-ink);
    }
  }
</style>
