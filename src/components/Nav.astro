---
const pathname = Astro.url.pathname;
const isActive = (href: string) => {
  if (href === '/') return pathname === '/';
  return pathname.startsWith(href);
};

const links = [
  { href: '/', label: 'Home' },
  { href: '/about', label: 'About' },
  { href: '/projects', label: 'Work' },
  { href: '/writing', label: 'Writing' },
];
---

<header class="nav">
  <div class="nav-inner">
    <a href="/" class="brand" aria-label="Aminu, home">
      <span class="brand-mark">Aminu</span>
    </a>
    <nav aria-label="Primary">
      <ul>
        {links.slice(1).map((link) => (
          <li>
            <a href={link.href} class:list={[{ active: isActive(link.href) }]}>
              {link.label}
            </a>
          </li>
        ))}
      </ul>
    </nav>
    <a class="contact" href="mailto:aminu0abdusalam@gmail.com">Say hello</a>
  </div>
</header>

<style>
  .nav {
    position: sticky;
    top: 0;
    z-index: 50;
    backdrop-filter: blur(18px);
    background: rgba(245, 243, 236, 0.9);
    border-bottom: 1px solid var(--color-border);
  }

  .nav-inner {
    max-width: 84rem;
    margin-inline: auto;
    padding: var(--space-4) var(--space-5);
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-5);
  }

  .brand {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    color: var(--color-text-strong);
    font-family: var(--font-display);
    font-size: var(--fs-lg);
    font-weight: 700;
    letter-spacing: -0.04em;
    transition: all var(--duration-base) var(--ease-out);
  }

  .brand:hover {
    color: var(--color-accent);
    transform: translateX(2px);
  }

  nav ul {
    display: flex;
    gap: var(--space-5);
    list-style: none;
  }

  nav a {
    color: var(--color-text-muted);
    font-size: var(--fs-sm);
    font-weight: 500;
    font-family: var(--font-mono);
    padding: var(--space-2) 0;
    position: relative;
    transition: color var(--duration-fast) var(--ease-out);
  }

  nav a::before {
    content: '';
    position: absolute;
    left: 0;
    right: 100%;
    bottom: 0;
    height: 1px;
    background: var(--color-accent);
    transition: right var(--duration-base) var(--ease-out);
  }

  nav a:hover,
  nav a.active {
    color: var(--color-text-strong);
  }

  nav a:hover::before,
  nav a.active::before {
    right: 0;
  }

  .contact {
    padding: var(--space-2) var(--space-4);
    border-radius: var(--radius-full);
    background: var(--color-text-strong);
    color: var(--color-bg-elevated);
    font-family: var(--font-mono);
    font-size: var(--fs-xs);
    box-shadow: 3px 3px 0 var(--color-border-strong);
  }

  .contact:hover {
    color: white;
    transform: translate(-2px, -2px);
  }

  @media (max-width: 480px) {
    .nav-inner {
      padding: var(--space-3) var(--space-4);
    }
    nav ul {
      gap: var(--space-4);
    }
    .contact {
      display: none;
    }
  }
</style>
